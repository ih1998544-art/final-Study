# Study Zone - Production Environment Configuration Template
# Server runtime port (must be 3000 in AI Studio preview)
PORT=3000

# Node environment: 'development' (Vite middleware) | 'production' (Static bundle)
NODE_ENV=development

# Google Gemini API key for server-side pedagogical inference & reasoning
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# JSON Web Token Secret for session signing and API authorization
JWT_SECRET=studyzone_production_secret_key_change_me_in_prod

# Database connection URL (for migration from in-memory store to PostgreSQL / Cloud SQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/studyzone
